# Strip the vanity import comments from the vendored pure-Go SQLite driver.
#
# github.com/glebarez/go-sqlite is a fork of modernc.org/sqlite that kept
# the parent's '// import "modernc.org/sqlite"' declaration. Module mode
# ignores such comments, but Fedora's %gobuild compiles in GOPATH mode
# (GO111MODULE=off), which enforces the declared import path and fails on
# the mismatch with the directory the package actually lives in.
#
# TODO: drop this patch once upstream removes the import comments, or once
# go-rpmdb registers the modernc.org/sqlite driver directly.
--- a/vendor/github.com/glebarez/go-sqlite/mutex.go	2026-11-04 12:22:35.931818779 -0500
+++ b/vendor/github.com/glebarez/go-sqlite/mutex.go	2026-11-04 12:22:35.934516113 -0500
@@ -2,7 +2,7 @@
 // Use of this source code is governed by a BSD-style
 // license that can be found in the LICENSE file.
 
-package sqlite // import "modernc.org/sqlite"
+package sqlite
 
 import (
 	"sync"
