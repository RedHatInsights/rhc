interface com.redhat.rhsm.testing.content.profile

type Metadata (
    # The user agent string (e.g. "rhc/1.2.3")
    user_agent: ?string,
    # The correlation id
    correlation_id: ?string,
    # The locale string (e.g. en_US.UTF-8)
    locale: ?string
)

# Any method in this interface can be used only in the situation, when the system is registered
error SystemNotRegistered()

# Candlepin server does not support uploading of profile
error ProfileNotSupported()

# Result of the synchronous Send() method. It is empty for now. It will be
# extended with the statistics of the uploaded profile in the future (status,
# updates, exceptions), when rhsm2 starts providing them.
type SendResult ()

# Method for gathering and uploading combined rpm profile to candlepin server.
# The combined profile will contain the list of installed rpms and the list of
# enabled repositories (modules were removed from DNF5). The upload is
# synchronous: the result is reported back and failures are returned as errors.
# It is intended for callers that need the result, like the dnf5 plugin
# implementing "dnf upload-profile".
method Send(
    metadata: ?Metadata
) -> (
    result: SendResult
)

# Asynchronous variant of Send(): the profile is gathered and uploaded in the
# background and failures are only logged by the server. It is intended for
# callers that must not be blocked by the upload, like the rhsm libdnf5 plugin
# uploading the profile at the end of a transaction.
method SendAsync(
    metadata: ?Metadata
) -> ()
