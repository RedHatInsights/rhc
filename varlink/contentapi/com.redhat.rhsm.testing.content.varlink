interface com.redhat.rhsm.testing.content

type Metadata (
    # The user agent string (e.g. "rhc/0.5.3")
    user_agent: ?string,
    # The correlation id
    correlation_id: ?string,
    # The locale string (e.g. en_US.UTF-8)
    locale: ?string
)

# Many methods in this interface can be used only in the situation, when the system is registered
error SystemNotRegistered()

# This error is used, when rhsm is configured to not manage content
error ContentNotManaged()

# This error is returned when a local file system operation fails
error IOFailed(message: string)

# Try to refresh entitlement certificate, when needed, and update
# redhat.repo file accordingly. The content (redhat.repo file) is
# generated from the SCA entitlement certificate. When force is true,
# the entitlement certificate is force recreated.
method Refresh(
    force: bool,
    metadata: ?Metadata
) -> (
    success: bool
)
